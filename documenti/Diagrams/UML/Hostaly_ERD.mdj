							},
							"font": "Arial;15;0",
							"left": 1648,
							"top": 120,
							"width": 297,
							"height": 817,
							"text": "users.role (Role):\n   - 'ADMIN'\n   - 'GESTORE'\n   - 'CLIENT\"\n\n\nrooms.type (RoomType):\n   - 'SINGLE'  (max 1)\n   - 'DOUBLE'  (max 2)\n   - 'SUITE'  (max 4)\n   - 'FAMILY'  (max 4)\n\n\nrooms.status (RoomStatus):\n   - 'MAINTENANCE' (Manutenzione)\n   - 'AVAILABLE'  (Disponibile)\n   - 'BOOKED\"   (Prenotata)\n   - 'OCCUPIED'  (Occupata)\n   - 'DIRTY'  (Da pulire)\n\n\nbookings.status (BookingStatus):\n   - 'PENDING'  (In attesa)\n   - 'CONFIRMED'  (confermata)\n   - 'CHECKED_IN'  (In corso)\n   - 'CHECKED_OUT' (Terminata)\n   - 'CANCELLED'  (Annullata)\n\n\nextra_services.category:\n   - \"BREAKFAST'  (Colazione)\n   - 'RESTAURANT'  (Ristorante)\n   - 'PARKING'  (Parcheggio)\n   - 'LAUNDRY'  (Lavanderia)\n   - 'MINIBAR'  (Minibar)\n   - 'SPA'  (Spa/Wellness)\n\n\ninvoices.status (InvoiceStatus):\n   - 'UNPAID\"  (Da pagare)\n   - 'PAID'  (Pagata)\n\n\ninvoice_lines.kind:\n   - 'ROOM'  (Soggiorno)\n   - 'SERVICE'  (Servizio extra)\n\n"
						}
					]
				},
